{
  "manifest_version": 3,
  "name": "Canon Store QA Tool",
  "version": "1.0",
  "description": "Performs QA checks on Canon store pages.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.canon.ie/store/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Canon QA Tool"
  }
}