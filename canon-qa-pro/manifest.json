{
  "manifest_version": 3,
  "name": "Canon QA Pro",
  "version": "1.0",
  "description": "Performs a detailed QA checklist for Canon store pages.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.canon.ie/store/*",
    "https://www.canon.ie/store/offers/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Run Canon QA Pro"
  }
}